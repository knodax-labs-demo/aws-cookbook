{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCURDelivery",
      "Effect": "Allow",
      "Principal": {
        "Service": "billingreports.amazonaws.com"
      },
      "Action": [
        "s3:GetBucketAcl",
        "s3:GetBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::$CUR_BUCKET"
    },
    {
      "Sid": "AllowCURWrite",
      "Effect": "Allow",
      "Principal": {
        "Service": "billingreports.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::$CUR_BUCKET/*"
    }
  ]
}
