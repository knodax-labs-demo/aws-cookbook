{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sns:Subscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:Receive"
      ],
      "Resource": "arn:aws:sns:us-east-1:123456789012:PipelineNotifications"
    },
    {
      "Effect": "Allow",
      "Action": [
        "codepipeline:GetPipelineState",
        "cloudwatch:DescribeAlarms",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    }
  ]
}
